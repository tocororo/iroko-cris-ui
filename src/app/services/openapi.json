          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/v1/cypher/fulltext": {
      "post": {
        "tags": ["cypher"],
        "summary": "Execute a full-text index search",
        "description": "Execute a full-text index search query.\n\n- **searchIndex**: The full-text index to use\n- **searchTerm**: The term to search for\n- **whereClause**: Additional WHERE clause for filtering\n- **returnClause**: RETURN clause for results\n- **orderClause**: ORDER BY clause for sorting\n- **parameters**: Optional query parameters\n- **countTotal**: Whether to return only the count",
        "operationId": "execute_fulltext_query_v1_cypher_fulltext_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FullTextCypherQuery" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": {} } }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/v1/cypher/fulltext/export/csv": {
      "post": {
        "tags": ["cypher"],
        "summary": "Export fulltext index search results to CSV",
        "description": "Export full-text search results as CSV download.\n\n- **searchIndex**: The full-text index to use\n- **searchTerm**: The term to search for\n- **whereClause**: Additional WHERE clause for filtering\n- **returnClause**: RETURN clause for results\n- **orderClause**: ORDER BY clause for sorting\n- **parameters**: Optional query parameters\n- **countTotal**: Whether to return only the count",
        "operationId": "fulltext_export_to_csv_v1_cypher_fulltext_export_csv_post",
