  "components": {
    "schemas": {
      "Body_login_for_access_token_v1_auth_token_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              { "type": "string", "pattern": "^password$" },
              { "type": "null" }
            ],
            "title": "Grant Type"
          },
          "username": { "type": "string", "title": "Username" },
          "password": { "type": "string", "title": "Password" },
          "scope": { "type": "string", "title": "Scope", "default": "" },
          "client_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": ["username", "password"],
        "title": "Body_login_for_access_token_v1_auth_token_post"
      },
      "CaptchaResponse": {
        "properties": {
          "captcha_id": { "type": "string", "title": "Captcha Id" },
          "captcha_image": { "type": "string", "title": "Captcha Image" },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": ["captcha_id", "captcha_image", "expires_at"],
        "title": "CaptchaResponse"
      },
      "CategoryResult": {
        "properties": {
          "title": { "type": "string", "title": "Title" },
          "id": { "type": "string", "title": "Id" },
          "questions": {
            "items": { "$ref": "#/components/schemas/QuestionResult" },
            "type": "array",
            "title": "Questions",
            "default": []
          },
          "recommendation": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Recommendation"
          },
          "result": {
            "anyOf": [
              { "type": "boolean" },
              { "type": "number" },
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Result"
          }
        },
        "type": "object",
        "required": ["title", "id"],
        "title": "CategoryResult"
      },
      "CypherQuery": {
        "properties": {
          "query": { "type": "string", "title": "Query" },
          "parameters": {
            "anyOf": [
              { "additionalProperties": true, "type": "object" },
              { "type": "null" }
            ],
            "title": "Parameters"
          },
          "readonly": {
            "type": "boolean",
            "title": "Readonly",
            "default": true
          }
        },
        "type": "object",
        "required": ["query"],
        "title": "CypherQuery",
        "example": {
          "parameters": { "name": "Alice" },
          "query": "MATCH (n:Person) WHERE n.name = $name RETURN n LIMIT 10",
          "readonly": true
        }
      },
      "EvaluationMethodology-Input": {
        "properties": {
          "id": { "type": "string", "title": "Id" },
          "name": { "type": "string", "title": "Name" },
          "version": { "type": "string", "title": "Version" },
          "description": { "type": "string", "title": "Description" },
          "entity": { "type": "string", "title": "Entity" },
          "sections": {
            "items": { "$ref": "#/components/schemas/MethodologySection" },
            "type": "array",
            "title": "Sections"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
